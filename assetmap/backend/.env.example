# ─────────────────────────────────────────────
# AssetMap Backend — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://assetmap:assetmap_dev_password@localhost:5432/assetmap
REDIS_URL=redis://localhost:6379

# Encryption
ENCRYPTION_KEY=               # 32-byte hex key for AES-256 (64 hex chars)
AADHAAR_SALT=                  # Random salt for Aadhaar SHA-256 hashing
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=                 # 32+ random bytes for cookie signing

# UIDAI (Aadhaar OKYC)
UIDAI_API_URL=https://developer.uidai.gov.in
UIDAI_AUA_CODE=
UIDAI_ASA_CODE=
UIDAI_LICENSE_KEY=
UIDAI_PRIVATE_KEY=             # For e-KYC XML signing (PEM, base64 encoded)

# Setu Account Aggregator
SETU_AA_BASE_URL=https://aa-sandbox.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_WEBHOOK_SECRET=
SETU_FIU_ENTITY_ID=

# Surepass (Land Records)
SUREPASS_API_URL=https://kyc-api.surepass.io/api/v1
SUREPASS_TOKEN=

# DigiLocker
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/digilocker/callback

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_DOCUMENTS=assetmap-documents-dev

# ─────────────────────────────────────────────
# Recovery Engine
# ─────────────────────────────────────────────
LEGAL_ENTITY_NAME="AssetMap Recovery Services Pvt. Ltd."
SUCCESS_FEE_MIN_PCT=5
SUCCESS_FEE_MAX_PCT=10
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
