{
  "name": "assetmap-backend",
  "version": "1.0.0",
  "description": "AssetMap — Aadhaar-linked asset discovery platform backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --env-file=.env --respawn --transpile-only --poll src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "security:check": "npm audit --audit-level=high && npx snyk test",
    "tunnel": "npx smee-client --url https://smee.io/assetmap-webhook --path /api/consent/callback --port 3000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@xmldom/xmldom": "^0.9.10",
    "argon2": "^0.44.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.5",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "firebase-admin": "^14.2.0",
    "ioredis": "^5.3.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "pg": "8.12.0",
    "qrcode": "^1.5.4",
    "resend": "^6.18.1",
    "speakeasy": "^2.0.0",
    "twilio": "^6.0.2",
    "winston": "3.11.0",
    "xml-crypto": "^6.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.10.9",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/xml-crypto": "^1.4.6",
    "@types/xmldom": "^0.1.34",
    "ts-node-dev": "2.0.0",
    "typescript": "5.3.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
