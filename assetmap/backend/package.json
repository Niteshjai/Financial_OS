{
  "name": "assetmap-backend",
  "version": "1.0.0",
  "description": "AssetMap — Aadhaar-linked asset discovery platform backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "security:check": "npm audit --audit-level=high && npx snyk test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "argon2": "^0.44.0",
    "axios": "^1.18.1",
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.3.2",
    "pg": "8.12.0",
    "twilio": "^6.0.2",
    "uuid": "^14.0.1",
    "winston": "3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.11.0",
    "@types/pg": "8.10.9",
    "@types/uuid": "^9.0.7",
    "ts-node-dev": "2.0.0",
    "typescript": "5.3.3"
  }
}
